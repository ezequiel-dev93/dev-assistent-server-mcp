# ============================================================================
# DevAssistant MCP Server v2.0 — Environment Configuration
# ============================================================================

# Allowed workspace roots (separated by ';' on Windows or ':' on macOS/Linux)
DEVASSISTANT_WORKSPACE_ROOTS=/path/to/your/workspace

# Local SQLite database path (defaults to ~/.dev-assistant/agent_memory.db)
# DEVASSISTANT_DB_PATH=/custom/path/to/agent_memory.db

# Logging level written strictly to stderr (DEBUG, INFO, WARNING, ERROR)
DEVASSISTANT_LOG_LEVEL=INFO

# Optional user-scoped author profile for `get_author_profile` tool
# DEVASSISTANT_AUTHOR_NAME="Your Name"
# DEVASSISTANT_AUTHOR_URL="https://your-portfolio.dev"
# DEVASSISTANT_AUTHOR_GITHUB="https://github.com/your-handle"
# DEVASSISTANT_AUTHOR_LINKEDIN="https://linkedin.com/in/your-handle"
# DEVASSISTANT_AUTHOR_EMAIL="you@example.com"
